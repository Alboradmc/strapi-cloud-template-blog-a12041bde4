{
  "collectionName": "components_shared_whatsapp_bookings",
  "info": {
    "displayName": "WhatsApp Booking",
    "icon": "phone",
    "description": "WhatsApp call-to-action with logo and phone number"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "label": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "phoneNumber": {
      "type": "string",
      "required": true,
      "regex": "^[0-9]{7,15}$",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "prefilledMessage": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "openInNewTab": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  },
  "config": {}
}
