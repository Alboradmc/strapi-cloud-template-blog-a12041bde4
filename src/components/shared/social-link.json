{
  "collectionName": "components_shared_social_links",
  "info": {
    "displayName": "Social Link",
    "icon": "dashboard"
  },
  "options": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Link": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^https?:\\/\\/(www\\.)?[a-zA-Z0-9-]+\\.[a-zA-Z]{2,}([\\/\\w\\-.?=&%+]*)?$",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "OpenInNewTab": {
      "type": "boolean",
      "required": false,
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Icon": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  },
  "config": {}
}
